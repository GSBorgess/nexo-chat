{
  "name": "@nexo-chat/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "prebuild": "npm run db:generate",
    "db:generate": "prisma generate",
    "lint": "eslint . --ext .ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "pretypecheck": "npm run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^6.0.0",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
